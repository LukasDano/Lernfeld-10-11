{
    "name": "laufchallenge",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint lf",
        "preview": "vite preview",
        "tsc": "tsc",
        "lint:all": "npm run lint:ts && npm run lint:tsx",
        "lint:ts": "eslint --ext .ts src/",
        "lint:tsx": "eslint --ext .tsx src/",
        "prettier:check": "npx prettier . --check",
        "prettier:format": "npx prettier . --write",
        "vitest:verbose": "npx vitest --reporter=verbose",
        "prepare-commit": "npm run tsc && npm run lint:all && npm run prettier:format && npm run vitest:verbose"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.90.11",
        "@tippyjs/react": "^4.2.6",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-icons": "^5.5.0",
        "sonner": "^2.0.7",
        "tippy.js": "^6.3.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/tailwindcss": "^3.0.11",
        "@vitejs/plugin-react": "^5.1.1",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jiti": "^2.6.1",
        "jsdom": "^27.2.0",
        "postcss": "^8.5.6",
        "prettier": "3.6.2",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "npm:rolldown-vite@7.2.5",
        "vitest": "^4.0.14"
    },
    "overrides": {
        "vite": "npm:rolldown-vite@7.2.5"
    }
}
